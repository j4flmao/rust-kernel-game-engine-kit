---
import Layout from '../layouts/Docs.astro';
import { defaultVersion, entries, loadDoc } from '../lib/docs.js';
export function getStaticPaths() {
  return [{ params: { slug: undefined }, props: { entry: entries[0], version: defaultVersion } }, ...entries.map(entry => ({ params: { slug: entry.slug }, props: { entry, version: defaultVersion } }))];
}
const doc = await loadDoc(Astro.props.entry, Astro.props.version);
---
<Layout doc={doc} />
